MISSING_ALERT_API_ID=your_api_id_here
MISSING_ALERT_API_KEY=your_api_key_here
DISASTER_MSG_API_KEY=your_api_key_here
KAKAO_REST_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
DATA_SOURCE=sample
SAFE182_SYNC_INTERVAL_SEC=300
GEMINI_CALL_INTERVAL_SEC=4
GEMINI_TIMEOUT_SEC=30
# FCM 서비스 계정 키 파일 경로 (저장소 밖에 둘 것). 비우거나 파일이 없으면 푸시만 꺼지고 서버는 돈다
FIREBASE_SERVICE_ACCOUNT_PATH=/Users/사용자이름/.missing-alert-care/firebase-service-account.json
# FCM 발송 타임아웃(초, 1~120). 넘으면 실패로 보고 다음 조회 때 다시 보낸다
FIREBASE_SEND_TIMEOUT_SEC=10
# AI 옷차림 추출 (1=켬, 0=끔). 비우면 sample=1, safe182=0 (실제 데이터는 외부 AI로 보내지 않음)
AI_EXTRACT_ENABLED=
# 1이면 푸시를 data만 보냄 (notification 없이, 앱이 data의 title·body로 직접 알림 표시). 기본 0
# 주의: data만 받아 알림을 띄우는 앱(PR #25 반영 이후 빌드)에서만 1로 켤 것. 그 전 앱은 알림이 표시되지 않음
PUSH_DATA_ONLY=0
